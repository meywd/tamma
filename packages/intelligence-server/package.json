{
  "name": "@tamma/intelligence-server",
  "version": "0.1.0",
  "type": "module",
  "description": "HTTP sidecar exposing @tamma/intelligence for the C# API to consume via HTTP.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "tamma-intelligence-server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@tamma/intelligence": "workspace:*",
    "@tamma/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
