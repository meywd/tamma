{
  "name": "@tamma/workflow-viewer",
  "version": "0.1.0",
  "description": "Presentational React + React Flow component that renders interactive Tamma workflow diagrams from workflow metadata.",
  "type": "module",
  "license": "SEE LICENSE IN ../../LICENSE",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
