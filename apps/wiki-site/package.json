{
  "name": "@tamma/wiki-site",
  "version": "1.0.0",
  "private": true,
  "description": "Tamma documentation and wiki site — Astro Starlight on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "sync-content": "tsx scripts/sync-content.ts",
    "dev": "pnpm sync-content && astro dev",
    "build": "pnpm sync-content && astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:prod": "pnpm build && wrangler deploy --config wrangler.jsonc",
    "astro": "astro"
  },
  "keywords": [
    "tamma",
    "documentation",
    "wiki",
    "astro",
    "starlight",
    "cloudflare-workers"
  ],
  "author": "Tamma Project",
  "license": "SEE LICENSE IN ../../LICENSE",
  "devDependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "@astrojs/starlight": "^0.33.0",
    "astro": "^5.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.79.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
