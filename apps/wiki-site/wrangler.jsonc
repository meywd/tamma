{
  // Tamma Documentation & Wiki Site
  // Pure static Astro site served via Cloudflare Workers Static Assets
  "name": "tamma-wiki-site",
  "compatibility_date": "2025-01-01",

  // Static assets — no Worker script needed for pure static sites
  "assets": {
    "directory": "./dist"
  },

  // Custom domain — wiki.tamma.dev
  "routes": [
    {
      "pattern": "wiki.tamma.dev",
      "zone_name": "tamma.dev"
    }
  ],

  "observability": {
    "enabled": true
  }
}
