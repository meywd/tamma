{
  // Tamma Documentation & Wiki Site
  // Deploys Astro Starlight to Cloudflare Workers
  "name": "tamma-wiki-site",
  "main": "dist/_worker.js",
  "compatibility_date": "2025-01-01",

  // Assets configuration for serving static files (Astro output)
  "assets": {
    "directory": "./dist/client"
  },

  // Environment variables
  "vars": {
    "ENVIRONMENT": "production"
  },

  // Custom domain routes
  "routes": [
    {
      "pattern": "wiki.tamma.dev/*",
      "zone_name": "tamma.dev"
    }
  ],

  // Observability
  "observability": {
    "enabled": true
  }
}
