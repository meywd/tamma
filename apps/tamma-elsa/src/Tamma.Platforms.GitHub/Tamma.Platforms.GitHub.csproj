<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tamma.Platforms.GitHub</RootNamespace>
    <AssemblyName>Tamma.Platforms.GitHub</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Tamma Team</Authors>
    <Description>
      Epic 31 P1 stage 2: GitHub git platform driver. Implements
      IGitPlatformDriver directly against the GitHub REST v3 + GraphQL
      v4 APIs — repo/branch/PR/issue/label/release/commit endpoints,
      the six 31-13 PR lifecycle verbs (draft toggle via GraphQL,
      GHES-aware endpoint), Actions dispatch + run monitor with
      pollable-run-id correlation, and webhook registration. Two
      credential modes through the factory seam: PAT/BYOK plaintext
      tokens and GitHub App installation-token minting (RS256 App JWT,
      absorbed from Tamma.Api's OctokitGitHubAppClient). No Octokit,
      no Tamma.Api/Tamma.Activities dependency — the absorb-don't-wrap
      decision of the Epic 31 execution plan.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <!-- Epic 31 P4 M4: sealed-box CI-secret encryption moved down from Tamma.Api with the provisioner. -->
    <PackageReference Include="Sodium.Core" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tamma.Platforms.Abstractions\Tamma.Platforms.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tamma.Platforms.GitHub.Tests" />
    <!-- Epic 31 P1 — PlatformCapabilityContractTests constructs the
         internal-ctor client to pin capability-flag ⇔ verb agreement. -->
    <InternalsVisibleTo Include="Tamma.Platforms.Tests" />
    <!-- Story 31-10 — the integration suite builds GitHubHttpClient
         internals for env-gated live-API runs. -->
    <InternalsVisibleTo Include="Tamma.Platforms.IntegrationTests" />
  </ItemGroup>

</Project>
