<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tamma.Api</RootNamespace>
    <AssemblyName>Tamma.Api</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Tamma Team</Authors>
    <Description>REST API for Tamma Mentorship Engine</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.OpenSearch" Version="1.3.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="8.0.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <!-- Epic 31 P4 M4: Octokit + Sodium.Core are GONE from Tamma.Api — the
         GitHub App metadata reads live in Tamma.Platforms.GitHub (plain REST,
         hand-rolled App JWT) and sealed-box CI-secret encryption moved down
         with the Story 31-8 provisioners into the driver projects. -->
    <!-- Distributed rate limiting (audit finding auth/014 follow-up). The
         RateLimitService is in-process by default; when
         ConnectionStrings:Redis is configured, the Redis-backed backend
         kicks in so multi-pod deployments share a window counter. -->
    <PackageReference Include="StackExchange.Redis" Version="2.12.14" />
    <!-- Story 35-1 (Epic 35 billing foundation): Stripe customer mapping +
         Product/Price/Meter catalog. v51.2.0 is the latest stable and supports
         .NET 8 (netstandard2.0 / netcore). All Stripe service classes
         (CustomerService / ProductService / PriceService / Billing.MeterService)
         are non-sealed with virtual *Async methods, so tests mock at the
         service-interface boundary — no live Stripe in CI. -->
    <PackageReference Include="Stripe.net" Version="51.2.0" />
    <!-- Story 41-30 (D8) — write-time cron validation for the scheduled-trigger
         admin API: a malformed expression is a typed 400 at PUT/POST time,
         never a fire-time throw. Cronos 0.11.0 is already in the restore graph
         (it is what Elsa.Scheduling itself parses with); the explicit
         reference declares the dependency. No new download. -->
    <PackageReference Include="Cronos" Version="0.11.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal helpers (e.g. sealed-box encryption) to the test
         project without widening the public API surface. -->
    <InternalsVisibleTo Include="Tamma.Api.Tests" />
    <!-- The provider golden/regression suite lives in Tamma.Activities.Tests
         (it needs ProviderAllowlist AND ProviderCatalog in one view) and
         drives the runner's internal LoadProviderConfig directly. -->
    <InternalsVisibleTo Include="Tamma.Activities.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Top-1000 common passwords (audit finding auth/013). Sourced from
         SecLists (MIT-licensed, Daniel Miessler 2018):
         Passwords/Common-Credentials/xato-net-10-million-passwords-1000.txt.
         Loaded into a FrozenSet at startup by PasswordStrengthValidator. -->
    <EmbeddedResource Include="Auth/common-passwords.txt">
      <LogicalName>Tamma.Api.Auth.common-passwords.txt</LogicalName>
    </EmbeddedResource>
    <!-- System prompt registry files (one per RolePhaseMap (role, action) cell
         plus one _system.md per role). Loaded at static init by
         Auth/PromptFileLoader.cs; the LogicalName keeps the path verbatim
         (forward slashes) so role/action parsing is deterministic instead of
         relying on MSBuild's default resource-name mangling. -->
    <EmbeddedResource Include="Prompts/**/*.md">
      <LogicalName>Prompts/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tamma.Core\Tamma.Core.csproj" />
    <ProjectReference Include="..\Tamma.Data\Tamma.Data.csproj" />
    <ProjectReference Include="..\Tamma.Activities\Tamma.Activities.csproj" />
    <!-- Story 31-2: platform abstraction + per-tenant resolver. The Api
         registers IPlatformResolver / IPlatformCredentialReader in
         Program.cs and adapts ISecretStore + ISecretStoreBackend into
         the credential reader so every secret read goes through Epic 29. -->
    <ProjectReference Include="..\Tamma.Platforms.Abstractions\Tamma.Platforms.Abstractions.csproj" />
    <ProjectReference Include="..\Tamma.Platforms\Tamma.Platforms.csproj" />
    <!-- Story 31-4: Gitea driver self-registers via AddGiteaPlatformDriver()
         in Program.cs. Keyed-DI factory under PlatformKind.Gitea is the only
         seam PlatformResolver consumes. -->
    <ProjectReference Include="..\Tamma.Platforms.Gitea\Tamma.Platforms.Gitea.csproj" />
    <!-- Story 31-6: GitLab driver. Registered via AddGitLabPlatform() in
         Program.cs and consumed by 31-2's PlatformResolver via keyed DI
         under PlatformKind.GitLab. -->
    <ProjectReference Include="..\Tamma.Platforms.GitLab\Tamma.Platforms.GitLab.csproj" />
    <!-- Story 31-3: GitHub driver. Wraps the existing
         IGitHubAppClient / IGitHubActionsClient behind IGitPlatformDriver
         so GitHub matches the Gitea / GitLab driver pattern. Registered
         via AddGitHubPlatformDriver() in Program.cs and consumed by 31-2's
         PlatformResolver via keyed DI under PlatformKind.GitHub. -->
    <ProjectReference Include="..\Tamma.Platforms.GitHub\Tamma.Platforms.GitHub.csproj" />

  </ItemGroup>

</Project>
