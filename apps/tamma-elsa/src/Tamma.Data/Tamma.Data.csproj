<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tamma.Data</RootNamespace>
    <AssemblyName>Tamma.Data</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Tamma Team</Authors>
    <Description>Data access layer for Tamma Mentorship Engine</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />
    <!-- Story 28-4: TenantConnectionPoolOptions binding via IConfigurationSection.Bind. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tamma.Core\Tamma.Core.csproj" />
    <!--
      Story 31-7: PlatformWebhookDeliveryRepository signs against the
      shared PlatformKind enum + PlatformKindWire mapping in
      Tamma.Platforms.Abstractions so the wire string ('github',
      'gitea', ...) cannot drift between the receiver, the repo, and
      the database CHECK constraint. Tamma.Platforms.Abstractions has
      zero runtime dependencies on Tamma.Data so this is acyclic
      (Data -> Platforms.Abstractions; Platforms -> Data; no cycle).
    -->
    <ProjectReference Include="..\Tamma.Platforms.Abstractions\Tamma.Platforms.Abstractions.csproj" />
  </ItemGroup>

  <!--
    Story 28-4 — expose internals (TenantConnectionHandle.Acquire,
    MarkPendingDispose, ctor) to the API test project so tests can
    drive the ref-count state machine directly. The handle's Acquire +
    MarkPendingDispose surface is intentionally internal — only the
    LRU resolver should mint/demote handles in production.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Tamma.Api.Tests" />
  </ItemGroup>

</Project>
