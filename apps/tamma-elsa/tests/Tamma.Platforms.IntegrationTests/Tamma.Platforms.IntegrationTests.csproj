<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Story 31-10 — Integration Test Harness for Epic 31 git-platform drivers.

    Tests run against real platform servers via Testcontainers. Skipped
    cleanly when Docker is not available (mirrors wave-A
    chromadb.integration.test.ts gating). Real driver code over real
    HTTP — NO mocks. Adding a new platform contract test here means
    bringing up its container in Fixtures/ + wiring a contract test
    class that drives the IGitPlatformClient + IGitPlatformActionsClient
    methods against the live API.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="NUnit.Analyzers" Version="3.10.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <!--
      Generic Testcontainers package — used for spinning up the
      gitea/gitea image. There is no Testcontainers.Gitea module
      shipped today; the generic ContainerBuilder is what we need.
    -->
    <PackageReference Include="Testcontainers" Version="3.10.0" />
    <!-- Epic 31 P5 M3 — the full-stack Gitea E2E boots Postgres for the
         host-run Tamma.Api and seeds/queries the control-plane store
         through the real EF model (Tamma.Data reference below). -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="3.10.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tamma.Platforms.Abstractions\Tamma.Platforms.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Tamma.Platforms.Gitea\Tamma.Platforms.Gitea.csproj" />
    <!-- Epic 31 P1 stage 2 — the GitHub suite drives the real driver
         (env-gated live API; no container image exists for GitHub). -->
    <ProjectReference Include="..\..\src\Tamma.Platforms.GitHub\Tamma.Platforms.GitHub.csproj" />
    <!-- Epic 31 P5 M3 — E2E fixture seeds the repo-grant rows + reads DCB
         events / webhook deliveries through the real EF model. -->
    <ProjectReference Include="..\..\src\Tamma.Data\Tamma.Data.csproj" />
  </ItemGroup>

  <!-- Epic 31 P5 M3 — the full-stack E2E launches the REAL Tamma.Api as a
       host process. The reference below only forces build ordering (the
       fixture runs the app from the Api project's own bin directory, not
       from this project's output); ReferenceOutputAssembly=false keeps the
       exe and its dependency closure out of the test bin. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Tamma.Api\Tamma.Api.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

</Project>
