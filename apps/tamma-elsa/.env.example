# Tamma ELSA Environment Variables
# Copy this file to .env and update values

# Database
DB_PASSWORD=tamma_dev_123

# RabbitMQ
RABBITMQ_PASSWORD=tamma_dev_123

# ELSA Server
ELSA_BASE_URL=http://localhost:5000

# External Integrations (optional for development)
SLACK_WEBHOOK=
GITHUB_TOKEN=

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production

# Docker Registry (for production)
DOCKER_REGISTRY=ghcr.io/your-org
VERSION=latest

# ── Tenant pre-drop backup (Story 28-5) — OFF by default ──────────────
# Enable a pg_dump snapshot of a tenant DB before DeleteTenantWorkflow
# drops it. Requires pg_dump on the elsa-server host (install
# postgresql-client in the image) + a durable mounted backup directory
# (uncomment the Backup__* env + tenant_backups volume in
# docker-compose*.yml). Leave false unless an SLA promises soft-delete
# recovery. See docs/deployment/tenant-deletion-backup.md.
# BACKUP_DELETION_BACKUP=false
# BACKUP_TIMEOUT_SECONDS=1800
