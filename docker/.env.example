# Tamma Docker Compose — Environment Variables
# Copy this file to .env and fill in the required values.

# ===== Required =====
POSTGRES_PASSWORD=changeme

# GitHub App credentials
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ===== Authentication =====
# GitHub OAuth App (for user login via GitHub)
# Create at: https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxxxx
GITHUB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

# JWT secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=change-me-to-a-random-string

# ===== OAuth2 Proxy (unified auth across all *.tamma.dev dashboards) =====
# Cookie secret for oauth2-proxy session encryption (32-byte base64)
# Generate with: python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
OAUTH2_PROXY_COOKIE_SECRET=

# ===== URLs =====
API_BASE_URL=https://api.tamma.dev
DASHBOARD_URL=https://app.tamma.dev

# ===== Optional (with defaults) =====
# POSTGRES_USER=tamma
# POSTGRES_DB=tamma
# RABBITMQ_USER=tamma
# RABBITMQ_PASSWORD=tamma
# LOG_LEVEL=info
