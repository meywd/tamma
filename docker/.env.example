# Tamma Docker Compose — Environment Variables
# Copy this file to .env and fill in the required values.

# ===== Required =====
POSTGRES_PASSWORD=changeme

# GitHub App credentials
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ===== Authentication =====
# GitHub OAuth App (for user login via GitHub)
# Create at: https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxxxx
GITHUB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

# JWT secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=change-me-to-a-random-string

# OAuth2 Proxy cookie secret (generate with: python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())')
# Required when oauth2-proxy is enabled; leave empty to skip oauth2-proxy.
OAUTH2_PROXY_COOKIE_SECRET=

# ELSA admin API key — presented as `Authorization: ApiKey <key>` on requests to
# the ELSA Server API. Used in two places: (1) nginx injects it on proxied
# /elsa/api/ requests, and (2) Tamma.Api presents it on its direct container-to-
# container hop to the engine (Elsa__ApiKey), which the engine's merge-approval
# resume seam now requires (SECURITY C3). The engine runs UseAdminApiKey(), whose
# AdminApiKeyProvider accepts ONLY the all-zero GUID, so set this to:
#   00000000-0000-0000-0000-000000000000
ELSA_ADMIN_API_KEY=00000000-0000-0000-0000-000000000000

# Service-to-service API key for internal calls (Elsa → tamma-api, tamma-api-dotnet → tamma-api).
# Generate via admin API: POST /api/admin/service-keys { serviceName: "elsa-server" }
# Or via CLI: tamma admin create-service-key --name elsa-server
TAMMA_SERVICE_API_KEY=

# ===== URLs =====
API_BASE_URL=https://api.tamma.dev
# Admin console (oauth2-proxy-gated — admin.tamma.dev since the 2026-07-28
# hostname re-layout; app.tamma.dev now serves the customer app). Also the
# CORS/base fallback when CUSTOMER_DASHBOARD_URL is unset.
DASHBOARD_URL=https://admin.tamma.dev
# Customer app (dash.tamma.dev — its own /login, no oauth2-proxy). All
# customer-facing links the API emails (verify, password reset, org invites)
# and the GitHub-install redirects are built from THIS value; it falls back
# to DASHBOARD_URL when unset so a single-dashboard install needs one setting.
# Leave commented unless your customer app has its own hostname — an
# always-set value here would defeat that fallback (and a copy-pasted
# dash.tamma.dev would email YOUR users' one-time tokens to tamma.dev).
#CUSTOMER_DASHBOARD_URL=https://dash.example.com
# Extra CORS origins for the customer app, CSV. Use when the customer app
# answers on MORE hostnames than CUSTOMER_DASHBOARD_URL (Tamma production
# serves it at both dash.tamma.dev and app.tamma.dev; app.tamma.dev goes
# here because dash.tamma.dev is already covered by CUSTOMER_DASHBOARD_URL).
# Leave unset if each app has exactly one hostname.
#DASHBOARD_ADDITIONAL_ORIGINS=https://app.example.com

# ===== OpenSearch Log Aggregation =====
# OpenSearch node URL (default: http://opensearch:9200 inside Docker network)
# OPENSEARCH_URL=http://opensearch:9200
# Set to "false" to disable OpenSearch log shipping (logs still go to stdout/file)
# OPENSEARCH_ENABLED=true
# Index name prefix for TypeScript services (default: tamma-ts)
# LOG_INDEX_PREFIX=tamma-ts

# ===== Optional (with defaults) =====
# POSTGRES_USER=tamma
# POSTGRES_DB=tamma
# RABBITMQ_USER=tamma
# RABBITMQ_PASSWORD=tamma
# LOG_LEVEL=info
