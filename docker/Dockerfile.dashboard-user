# ------------------------------------------------------------------
# Dockerfile.dashboard-user  –  Customer-facing Vite React SPA (nginx)
#
# Build from the repo root:
#   docker build -f docker/Dockerfile.dashboard-user -t tamma-dashboard-user .
# ------------------------------------------------------------------

# ---- Stage 1: Build ----
FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/dashboard-user/package.json packages/dashboard-user/
# Unlike Dockerfile.dashboard there is NO @tamma/shared stage: the customer
# app declares zero workspace dependencies (react/react-dom/react-router-dom
# only) and its tsconfig has no `references` block. The `...` on the filter
# keeps this file correct the day someone adds one.

RUN pnpm install --frozen-lockfile --filter @tamma/dashboard-user...

COPY tsconfig.json ./
COPY packages/dashboard-user packages/dashboard-user

RUN pnpm --filter @tamma/dashboard-user run build

# ---- Stage 2: Runtime (nginx) ----
FROM nginx:1.27-alpine AS runtime
RUN addgroup -g 1001 tamma && adduser -u 1001 -G tamma -s /bin/sh -D tamma

COPY docker/nginx-dashboard-user.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/dashboard-user/dist /usr/share/nginx/html

EXPOSE 3002

# 127.0.0.1, not localhost: nginx listens IPv4-only and busybox wget
# resolves localhost to ::1 without falling back -> permanent unhealthy
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3002/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
