{
  "name": "tamma",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered autonomous development orchestration platform",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "vitest",
    "test:unit": "vitest --run --testPathPattern=\\.unit\\.test\\.ts$",
    "test:integration": "vitest --run --testPathPattern=\\.integration\\.test\\.ts$",
    "test:e2e": "vitest run --testPathPattern=\\.e2e\\.test\\.ts$ --testTimeout=300000",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --build packages/shared packages/platforms packages/providers packages/orchestrator packages/cli",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "migrate:latest": "pnpm --filter @tamma/orchestrator run migrate:latest",
    "migrate:rollback": "pnpm --filter @tamma/orchestrator run migrate:rollback",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "e2e:report": "playwright show-report e2e/playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.0",
    "prettier": "^3.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vitest": "^4.1.5"
  },
  "keywords": [
    "ai",
    "automation",
    "orchestration",
    "development",
    "workflow",
    "autonomous"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/meywd/tamma.git"
  },
  "license": "MIT",
  "author": "meywd",
  "pnpm": {
    "overrides": {
      "lodash@<4.18.0": "^4.18.0",
      "lodash-es@<4.18.0": "^4.18.0",
      "undici@^6": "^6.24.0",
      "undici@^7": "^7.24.0",
      "glob@>=10.0.0 <10.5.0": "^10.5.0",
      "minimatch@<3.1.3": "^3.1.3",
      "minimatch@^9": "^9.0.7",
      "vite@^8": "^8.0.10",
      "rollup@^4": "^4.59.0",
      "ajv@^8": "^8.18.0",
      "mdast-util-to-hast@^13": "^13.2.1",
      "qs@^6": "^6.14.2",
      "diff@^4": "^4.0.4",
      "js-yaml@^3": "^3.14.2",
      "js-yaml@^4": "^4.1.1",
      "picomatch@^2": "^2.3.2",
      "picomatch@^4": "^4.0.4",
      "path-to-regexp@^8": "^8.4.0",
      "dompurify@^3": "^3.4.0",
      "hono@^4": "^4.12.14",
      "@hono/node-server@<1.19.13": "^1.19.13"
    }
  }
}
